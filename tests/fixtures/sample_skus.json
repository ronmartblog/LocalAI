{
  "_readme": "Sample SKU fixture for the test suite. Eight generic profiles spanning CPU-only to high-VRAM GPU. The fixture exists so tests can exercise the full SKU loader / resolver / count-table contracts WITHOUT depending on the maintainer's private skus.json (which uses vendor-specific SKU names). Loaded into system_info.BENCHMARK_SKU_PROFILES by tests/conftest.py for the duration of the test session.",
  "version": 3,
  "feature": {
    "enabled_label": "Sample",
    "device_label": "Device",
    "detecting_text": "Device: detecting \u2026",
    "not_detected_text": "Device: not detected",
    "banner_label": "Device:",
    "filter_label": "Sample SKU filter:",
    "all_filter_value": "All SKUs",
    "settings_title": "Sample SKUs",
    "reload_button": "Reload Sample SKUs",
    "open_button": "Open SKU File",
    "compatibility_prefix": "Sample compatible:",
    "requires_more_text": "Sample: requires more VRAM than any known SKU"
  },
  "bench_defaults": {
    "_readme": "Sample baselines for the fixture; not tied to any real hardware product.",
    "baselines": {
      "quick_chat": [
        "qwen2.5:0.5b",
        "llama3.2:1b",
        "llama3.2:3b",
        "phi4:mini"
      ],
      "extended_chat": [
        "qwen2.5:0.5b",
        "llama3.2:1b",
        "llama3.2:3b",
        "phi4:mini",
        "phi4",
        "mistral-nemo",
        "qwen2.5vl-7b"
      ],
      "gpu_image_base": [
        "sdxl-base",
        "flux1-schnell-q4",
        "z-image-turbo",
        "realistic-vision-v6"
      ]
    }
  },
  "skus": [
    {
      "name": "Small CPU",
      "vm_size_pattern": "Standard_D4s_v#",
      "cpu": 4,
      "ram_gb": 16,
      "vram_gb": 0,
      "gpu_fraction": "None",
      "bench_quick_models": { "inherit": "quick_chat" },
      "bench_extended_models": { "inherit": "extended_chat" },
      "recommended_models": [
        "llama3.2:1b",
        "phi4:mini"
      ]
    },
    {
      "name": "Medium CPU",
      "vm_size_pattern": "Standard_D8s_v#",
      "cpu": 8,
      "ram_gb": 32,
      "vram_gb": 0,
      "gpu_fraction": "None",
      "bench_quick_models": { "inherit": "quick_chat" },
      "bench_extended_models": { "inherit": "extended_chat" },
      "recommended_models": [
        "llama3.2:1b",
        "llama3.2:3b",
        "phi4:mini"
      ]
    },
    {
      "name": "Large CPU",
      "vm_size_pattern": "Standard_D16s_v#",
      "cpu": 16,
      "ram_gb": 64,
      "vram_gb": 0,
      "gpu_fraction": "None",
      "bench_quick_models": { "inherit": "quick_chat" },
      "bench_extended_models": { "inherit": "extended_chat" },
      "recommended_models": [
        "llama3.2:3b",
        "phi4:mini",
        "phi4"
      ]
    },
    {
      "name": "XL CPU",
      "vm_size_pattern": "Standard_D32s_v#",
      "cpu": 32,
      "ram_gb": 128,
      "vram_gb": 0,
      "gpu_fraction": "None",
